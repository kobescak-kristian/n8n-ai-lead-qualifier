    {
      "parameters": {
        "jsCode": "const log = $input.all().map((i) => i.json).filter((j) => j && j.id !== undefined);\nreturn [{ json: { log } }];\n"
      },
      "id": "0a0ebf0e-e3a6-43bf-b25d-48fff8a5f3c6",
      "name": "Collect rows",
